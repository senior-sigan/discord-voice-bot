{
  "name": "voice-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "start": "npm run type && node --env-file=.env src/main.ts",
    "start:select": "npm run type && node --env-file=.env src/main.ts --select-model",
    "ai:login": "mkdir -p \"${DATA_DIR:-.data}\" && cd \"${DATA_DIR:-.data}\" && pi-ai login openai-codex",
    "generate-fillers": "npm run type && node --env-file=.env src/scripts/generate-fillers.ts",
    "export-memes": "npm run type && node --env-file=.env src/scripts/export-memes.ts",
    "explain-memes": "npm run type && node --env-file=.env src/scripts/explain-memes.ts",
    "index-memes": "npm run type && node --env-file=.env src/scripts/index-memes.ts",
    "sleep": "npm run type && node --env-file=.env src/scripts/sleep.ts",
    "test": "npm run type && node --test src/main.test.ts src/search/search.test.ts",
    "type": "tsc --noEmit",
    "check": "npm run type && npm run lint && npm run format"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@huggingface/transformers": "4.2.0",
    "@zvec/zvec": "0.7.1",
    "croner": "10.0.1",
    "discord.js": "14.27.0",
    "sherpa-onnx-node": "1.13.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.10.1",
    "typescript": "^7.0.2"
  }
}
